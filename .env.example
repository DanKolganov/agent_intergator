# ─── Required ────────────────────────────────────────────────────────────────

# Postgres (Supabase). Get from Supabase: Project → Settings → Database →
# Connection string (URI). Use pooler endpoint for serverless deploys.
DATABASE_URL=postgresql://postgres.YOUR_REF:YOUR_PASSWORD@aws-0-eu-west-1.pooler.supabase.com:6543/postgres?sslmode=require

# Random 32+ char string for express-session cookie signing.
# Generate: `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`
SESSION_SECRET=

# LLM for /recommend, /generate-draft, /ask, /analyze. OpenAI-compatible API.
# Recommended: Groq (free tier, fast). Sign up at console.groq.com.
AI_INTEGRATIONS_OPENAI_API_KEY=
AI_INTEGRATIONS_OPENAI_BASE_URL=https://api.groq.com/openai/v1
AI_INTEGRATIONS_MODEL=llama-3.1-8b-instant

# ─── Optional ────────────────────────────────────────────────────────────────

PORT=5000

# Restrict CORS in production to a single origin. If unset, all origins allowed
# (only safe in dev). Set this on Render to your public site URL.
FRONTEND_ORIGIN=

# Support contacts shown on consultation prompts. Set in prod, otherwise
# placeholder is displayed.
SUPPORT_TELEGRAM=https://t.me/your_support
SUPPORT_EMAIL=support@example.com
SUPPORT_PHONE=

# Replit OIDC — only needed when running on Replit. Leave blank elsewhere.
REPL_ID=
ISSUER_URL=https://replit.com/oidc

# ─── GitHub awesome-list importer (npm run agents:import) ────────────────────

# Source awesome-list, "owner/repo". README is fetched and parsed for
# github.com/* links — each linked repo becomes a candidate agent card.
AWESOME_LIST_REPO=e2b-dev/awesome-ai-agents
# Classic PAT with public_repo scope, or fine-grained token. Lifts rate limit
# from 60 to 5000 req/h. Get one at github.com/settings/tokens.
GITHUB_TOKEN=
# Stop after N successfully normalized agents per run.
IMPORT_LIMIT=20
# Skip repos with fewer stars than this.
MIN_STARS=500
# Parallel GitHub+LLM workers.
IMPORT_CONCURRENCY=2
