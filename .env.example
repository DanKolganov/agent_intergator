# Postgres (Supabase) — required for the app API
# Supabase Dashboard → Project Settings → Database → Connection string (URI)
# Use "Session mode" pooler or direct: postgresql://postgres.[ref]:[PASSWORD]@aws-0-eu-west-1.pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres

# Optional: sync agents table via supabase-js (deploy script / CI only)
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=your-anon-key

# Session secret for express-session (required)
SESSION_SECRET=replace-with-a-very-strong-secret

# Replit OIDC (optional — only if using Replit Auth)
REPL_ID=
ISSUER_URL=https://replit.com/oidc

# OpenAI / Groq integration (optional)
AI_INTEGRATIONS_OPENAI_API_KEY=
AI_INTEGRATIONS_OPENAI_BASE_URL=
AI_INTEGRATIONS_MODEL=llama-3.1-8b-instant

PORT=5000
